# Privy app id — required for every wallet connection: browser wallets, mobile
# wallets, and the embedded wallet offered to anyone who arrives without one.
# Create one at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy app client id. Optional, and only needed when the app is registered
# per client in the Privy dashboard.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Optional private RPC endpoint for Robinhood Chain (4663). When empty the app
# falls back to the public endpoint bundled with viem.
NEXT_PUBLIC_RPC_4663=

# Routing venue. Leave every field below empty and the app resolves the venue by
# itself: it reads the DEX config the Pons launchpad stores on chain — factory,
# router, wrapped native and fee tier — and falls back to the Uniswap v3
# deployment it ships with, which was read off chain 4663 and covers the quoter
# and the USD unit as well. Set them to pin the build to a venue of your own
# instead; the factory, router and wrapped address are required together, and
# anything short of all three is ignored rather than half-applied.
NEXT_PUBLIC_FACTORY_4663=
NEXT_PUBLIC_ROUTER_4663=
NEXT_PUBLIC_WRAPPED_4663=
NEXT_PUBLIC_WRAPPED_SYMBOL_4663=
# Fee tier the venue opens pools at, probed ahead of the standard ladder.
NEXT_PUBLIC_POOL_FEE_4663=

# Uniswap v3 QuoterV2. Optional, and not part of the launchpad's record, so a
# venue read off the launchpad borrows the quoter the app ships with when both
# point at the same factory and router. Without a quoter at all the app prices
# from the pool's own state and labels the result an estimate.
NEXT_PUBLIC_QUOTER_4663=

# USD unit used to value a portfolio. Optional, and borrowed from the shipped
# deployment on the same terms as the quoter above; with no USD unit at all,
# balances are listed without a dollar figure rather than valued in a unit
# nobody chose.
NEXT_PUBLIC_STABLE_4663=
NEXT_PUBLIC_STABLE_SYMBOL_4663=
NEXT_PUBLIC_STABLE_NAME_4663=
NEXT_PUBLIC_STABLE_DECIMALS_4663=

# Holdings indexer. The chain can say how much of a named token an address
# holds; it cannot say which tokens to name, so the list of what a wallet holds
# is read from the Blockscout instance the chain's explorer runs on — the same
# way every popular wallet answers it. Defaults to the explorer in the chain
# definition. Point it at your own instance, or set it to `off` to fall back to
# reading only the tokens the app already knows about.
NEXT_PUBLIC_BLOCKSCOUT_4663=

# Server-side indexer URL, used only by the same-origin fallback route that
# covers readers whose browser cannot reach the indexer directly. Set this to
# relay through an instance whose URL should not ship to every reader; when
# empty the route uses the public variable above.
BLOCKSCOUT_4663=

# Market prices come from DexScreener, because no token on this chain publishes
# one — which means the reader's browser tells it which contracts they are
# looking at. Set this to `off` to keep every lookup on chain, and portfolio
# values will fall back to each token's own pool against the USD unit.
NEXT_PUBLIC_DEXSCREENER=

# DexScreener keys chains by its own slug rather than by chain id, and Robinhood
# Chain's could not be confirmed when this was written; it defaults to
# `robinhood`. Confirm it against a token you know trades on 4663:
#   curl -s https://api.dexscreener.com/latest/dex/tokens/<address> \
#     | grep -o '"chainId":"[^"]*"' | sort -u
NEXT_PUBLIC_DEXSCREENER_CHAIN=

# Public origin of the deployment, used to resolve Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=
