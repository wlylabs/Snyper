# Privy app id — required for every wallet connection: browser wallets, mobile
# wallets, and the embedded wallet offered to anyone who arrives without one.
# Create one at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy app client id. Optional, and only needed when the app is registered
# per client in the Privy dashboard.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Optional private RPC endpoint for Robinhood Chain (4663). When empty the app
# falls back to the public endpoint bundled with viem.
NEXT_PUBLIC_RPC_4663=

# Routing venue. Leave every field below empty and the app resolves the venue at
# runtime by reading the DEX config the Pons launchpad stores on chain — that
# covers the factory, the router and the wrapped native token, which is enough
# to trade. Set them to pin the build to a venue of your own instead; the factory,
# router and wrapped address are required together, and anything short of all
# three is ignored rather than half-applied.
NEXT_PUBLIC_FACTORY_4663=
NEXT_PUBLIC_ROUTER_4663=
NEXT_PUBLIC_WRAPPED_4663=
NEXT_PUBLIC_WRAPPED_SYMBOL_4663=
# Fee tier the venue opens pools at, probed ahead of the standard ladder.
NEXT_PUBLIC_POOL_FEE_4663=

# Uniswap v3 QuoterV2. Optional, and not part of the launchpad's record: without
# it the app prices from the pool's own state and labels the result an estimate.
NEXT_PUBLIC_QUOTER_4663=

# USD unit used to value a portfolio. Optional; without it balances are listed
# without a dollar figure rather than valued in a unit nobody chose.
NEXT_PUBLIC_STABLE_4663=
NEXT_PUBLIC_STABLE_SYMBOL_4663=
NEXT_PUBLIC_STABLE_DECIMALS_4663=

# Public origin of the deployment, used to resolve Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=
