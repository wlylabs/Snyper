# Privy app id — required for every wallet connection: browser wallets, mobile
# wallets, and the embedded wallet offered to anyone who arrives without one.
# Create one at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy app client id. Optional, and only needed when the app is registered
# per client in the Privy dashboard.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Optional private RPC endpoint for Robinhood Chain (4663). When empty the app
# falls back to the public endpoint bundled with viem.
NEXT_PUBLIC_RPC_4663=

# Server-side RPC endpoint for chain 4663, used by the same-origin relay at
# /api/rpc that covers readers whose browser cannot reach the chain directly —
# a rate limited front door, a network or an extension that blocks RPC hosts.
# Set this to relay through an endpoint whose URL should not ship to every
# reader; when empty the relay uses the public variable above, and failing that
# the endpoint in the chain definition.
RPC_4663=

# Public origin of the deployment, used to resolve Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=
