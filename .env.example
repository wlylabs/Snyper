# WalletConnect / Reown project id — required for mobile wallet connections (QR + deep links).
# Create one at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional private RPC endpoints. When empty the app falls back to the public
# endpoints bundled with viem for each chain.
NEXT_PUBLIC_RPC_1=
NEXT_PUBLIC_RPC_10=
NEXT_PUBLIC_RPC_137=
NEXT_PUBLIC_RPC_8453=
NEXT_PUBLIC_RPC_42161=
NEXT_PUBLIC_RPC_4663=

# Robinhood Chain (4663) ships no canonical Uniswap v3 deployment, so the app
# keeps it read-only: balances, transfers and token detection work, pricing and
# swaps stay off. Fill in every address below to point the chain at a venue and
# routing turns on; leave any of them blank and it stays read-only.
NEXT_PUBLIC_QUOTER_4663=
NEXT_PUBLIC_FACTORY_4663=
NEXT_PUBLIC_ROUTER_4663=
NEXT_PUBLIC_WRAPPED_4663=
NEXT_PUBLIC_WRAPPED_SYMBOL_4663=
NEXT_PUBLIC_STABLE_4663=
NEXT_PUBLIC_STABLE_SYMBOL_4663=
NEXT_PUBLIC_STABLE_DECIMALS_4663=

# Public origin of the deployment, used to resolve Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=
