{
  "name": "Snyper — On-chain execution terminal",
  "short_name": "Snyper",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#07080a",
  "theme_color": "#07080a",
  "description": "Non-custodial execution terminal: connect a wallet, price routes on-chain and run interval, grid, trigger and trailing strategies from any device.",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Strategies", "short_name": "Strategies", "url": "/bots", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Assets", "short_name": "Assets", "url": "/assets", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Activity", "short_name": "Activity", "url": "/activity", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
